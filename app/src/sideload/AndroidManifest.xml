<?xml version="1.0" encoding="utf-8"?>
<!--
	Permissions only the GitHub/sideload build is allowed to have.

	INTERNET: exclusively to ask api.github.com whether a newer release exists
	and to download that APK. Nothing else in the app makes a request, and the
	check does not run at all until the user opts in. It is also what lets the
	app listen on the loopback address (PatchServer.kt), which is off until the
	user switches the chat link on and cannot be reached from another device.

	REQUEST_INSTALL_PACKAGES: to hand the downloaded APK to the system
	installer, which still shows its own confirmation screen. Android also
	refuses any update signed with a different key than the installed app.

	RUN_COMMAND: Termux's own permission, asked for when the chat is first
	opened: the chat is answered by a program in Termux, which the app starts
	(TermuxBridge.kt).

	The Play build (src/play/) has none of them, and its updater is a no-op.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
	<uses-permission android:name="com.termux.permission.RUN_COMMAND" />

	<queries>
		<package android:name="com.termux" />
	</queries>

</manifest>
